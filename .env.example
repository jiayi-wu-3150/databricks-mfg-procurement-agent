# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

# TODO: Update with the MLflow experiment you want to log traces and models to
MLFLOW_EXPERIMENT_ID=

# TODO: Update with your Lakebase instance for session storage and long-running task persistence
# Option 1 (preferred): Autoscaling endpoint name
# LAKEBASE_AUTOSCALING_ENDPOINT=
# Option 2: Autoscaling instance (set project and branch)
# LAKEBASE_AUTOSCALING_PROJECT=
# LAKEBASE_AUTOSCALING_BRANCH=
# Option 3: Provisioned instance (set instance name)
# LAKEBASE_INSTANCE_NAME=
LAKEBASE_AGENT_MEMORY_SCHEMA=agent_openai_memory

# Max seconds for background agent tasks (default 1 hour)
TASK_TIMEOUT_SECONDS=3600
# Poll interval in seconds when streaming retrieve results
POLL_INTERVAL_SECONDS=1

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
# IMPORTANT: For local development, use databricks (for default profile) or databricks://<profile-name> to specify which Databricks CLI profile to use
# This is automatically configured by the quickstart script
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"

# --- MLflow OpenTelemetry (OTLP) trace export --------------------------------
# Ship agent traces to an external OpenTelemetry backend (Datadog, Grafana/Tempo,
# Honeycomb, a collector, etc.) IN ADDITION TO the Databricks MLflow experiment.
#
# GOTCHA: setting OTEL_EXPORTER_OTLP_TRACES_ENDPOINT alone makes MLflow export
# traces to OTLP *instead of* the Databricks backend. Keep DUAL_EXPORT=true so
# traces land in BOTH places. All vars must be set before the app process starts.
#
# To activate: uncomment the endpoint (+ headers) below and set MLFLOW_TRACE_ENABLE_OTLP_DUAL_EXPORT=true.
MLFLOW_TRACE_ENABLE_OTLP_DUAL_EXPORT=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://<your-otel-collector>/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=api-key=<your-api-key>
# -----------------------------------------------------------------------------
